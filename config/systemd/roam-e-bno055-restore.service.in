[Unit]
Description=Restore Roam-E BNO055 calibration
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=@PROJECT_ROOT@
Environment=PYTHONUNBUFFERED=1

ExecStartPre=/usr/bin/test -c /dev/i2c-3
ExecStartPre=/usr/bin/test -x @PROJECT_ROOT@/.venv/bin/python
ExecStartPre=/usr/bin/test -r @PROJECT_ROOT@/scripts/bno055/restore.py
ExecStartPre=/usr/bin/test -r @PROJECT_ROOT@/config/bno055_calibration.json
ExecStart=@PROJECT_ROOT@/.venv/bin/python @PROJECT_ROOT@/scripts/bno055/restore.py

RemainAfterExit=yes
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
