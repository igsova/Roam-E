<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="roam_e">
  <!-- Roam-E visual and TF model, in SI units. Frame poses and wheel geometry come from
       calibration_file (default config/calibration.yaml). Keep
       include_camera_optical_frames false when the camera driver publishes the optical
       frames. -->
  <xacro:arg name="calibration_file" default="../config/calibration.yaml"/>
  <xacro:arg name="include_camera_optical_frames" default="false"/>
  <xacro:property name="calibration" value="${xacro.load_yaml('$(arg calibration_file)')}"/>
  <xacro:property name="wheel_radius" value="${calibration['physical_wheels']['radius']}"/>
  <xacro:property name="wheel_separation" value="${calibration['physical_wheels']['separation']}"/>
  <xacro:property name="wheel_width" value="${calibration['physical_wheels']['width']}"/>
  <xacro:include filename="visuals.xacro"/>

  <xacro:macro name="fixed_frame" params="child">
    <joint name="${child}_joint" type="fixed">
      <parent link="${calibration['frames'][child]['parent']}"/>
      <child link="${child}"/>
      <origin xyz="${' '.join(str(v) for v in calibration['frames'][child]['xyz'])}"
              rpy="${' '.join(str(v) for v in calibration['frames'][child]['rpy'])}"/>
    </joint>
  </xacro:macro>

  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>
  <xacro:rigid_links/>

  <xacro:macro name="wheel" params="side sign">
    <link name="${side}_wheel_link">
      <xacro:link_visuals link="${side}_wheel_link"/>
      <collision>
        <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${side}_wheel_link"/>
      <origin xyz="0 ${sign * wheel_separation / 2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="5.0" velocity="20.0"/>
    </joint>
  </xacro:macro>
  <xacro:wheel side="left" sign="1"/>
  <xacro:wheel side="right" sign="-1"/>

  <link name="imu_link"/>
  <xacro:fixed_frame child="imu_link"/>
  <!-- CAD-nominal optical frames, for viewing the model without the camera driver. -->
  <xacro:if value="$(arg include_camera_optical_frames)">
    <link name="camera_rgb_optical_frame"/>
    <xacro:fixed_frame child="camera_rgb_optical_frame"/>
    <link name="camera_depth_optical_frame"/>
    <xacro:fixed_frame child="camera_depth_optical_frame"/>
    <link name="camera_ir_optical_frame"/>
    <xacro:fixed_frame child="camera_ir_optical_frame"/>
  </xacro:if>
</robot>
