<?xml version="1.0"?>
<!-- Resolved runtime URDF. Edit roam_e.urdf.xacro first when changing geometry. -->
<robot name="roam_e">
  <material name="chassis_dark">
    <color rgba="0.12 0.14 0.16 1.0"/>
  </material>
  <material name="wheel_black">
    <color rgba="0.035 0.035 0.035 1.0"/>
  </material>
  <material name="lidar_black">
    <color rgba="0.08 0.08 0.09 1.0"/>
  </material>
  <material name="sensor_green">
    <color rgba="0.05 0.40 0.18 1.0"/>
  </material>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://roam_e_description/meshes/base_link.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="chassis_dark"/>
    </visual>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.033875" rpy="0 0 0"/>
  </joint>

  <link name="left_wheel_link">
    <visual>
      <geometry>
        <mesh filename="package://roam_e_description/meshes/left_wheel_link.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.570796327 0 0"/>
      <geometry>
        <cylinder radius="0.033875" length="0.029"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 0.086815 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="5.0" velocity="20.0"/>
  </joint>

  <link name="right_wheel_link">
    <visual>
      <geometry>
        <mesh filename="package://roam_e_description/meshes/right_wheel_link.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.570796327 0 0"/>
      <geometry>
        <cylinder radius="0.033875" length="0.029"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 -0.086815 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="5.0" velocity="20.0"/>
  </joint>

  <link name="laser_frame">
    <visual>
      <geometry>
        <mesh filename="package://roam_e_description/meshes/laser_frame.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="lidar_black"/>
    </visual>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="0.017447 -0.000870 0.176897" rpy="0 0 0"/>
  </joint>

  <link name="imu_mount_link">
    <visual>
      <geometry>
        <mesh filename="package://roam_e_description/meshes/imu_mount_link.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="sensor_green"/>
    </visual>
  </link>

  <joint name="imu_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_mount_link"/>
    <origin xyz="0.024045 0 0.102297" rpy="0 0 0"/>
  </joint>

  <link name="imu_link"/>

  <joint name="imu_sensor_joint" type="fixed">
    <parent link="imu_mount_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="3.141592654 0 0"/>
  </joint>
</robot>

